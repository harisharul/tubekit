# Copy to .env and fill in what you need. Never commit .env.

# Serve the endpoint at /mcp/<secret> instead of /mcp. Generate: openssl rand -hex 24
MCP_SECRET_PATH=

# Comma-separated Host headers to accept, e.g. tubekit.example.com.
# Set this whenever the server sits behind a proxy or tunnel.
MCP_ALLOWED_HOSTS=

# Optional Cloudflare tunnel: uncomment both lines.
# COMPOSE_PROFILES=cloudflare
# TUNNEL_TOKEN=
